{
  "name": "recordatorios",
  "version": "1.0.0",
  "description": "Tu compañero de estudio: tareas, rachas y avisos en horas libres",
  "main": "index.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/api.test.js test/schedule.test.js",
    "check": "node --check server.js && node --check public/app.js && node --check worker.mjs && node --check scripts/deploy-cloud.mjs",
    "dev:cloud": "wrangler dev",
    "build:cloud": "wrangler deploy --dry-run --outdir .wrangler/build",
    "db:local": "wrangler d1 migrations apply impulso --local",
    "db:remote": "wrangler d1 migrations apply impulso --remote",
    "deploy:cloud": "node scripts/deploy-cloud.mjs",
    "test:cloud": "npm run build:cloud && node --test test/cloud.test.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matpaz400/Recordatorios.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/matpaz400/Recordatorios/issues"
  },
  "homepage": "https://github.com/matpaz400/Recordatorios#readme",
  "dependencies": {
    "web-push": "^3.6.7"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "miniflare": "5.20261006.0-alpha",
    "wrangler": "^4.148.0"
  }
}
